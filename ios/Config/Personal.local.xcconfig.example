// Template for Personal.local.xcconfig (gitignored), used by the Toriwords-Personal scheme:
//   cp ios/Config/Personal.local.xcconfig.example ios/Config/Personal.local.xcconfig
// then fill in both values and run `tuist generate`.

// Your Personal Team ID: Xcode → Settings → Accounts → your Apple ID → Team ("Personal Team").
DEVELOPMENT_TEAM = TEAMID0000

// A bundle ID prefix nobody else has registered; the extensions append .share and .widget.
TORI_BUNDLE_ID = com.yourname.toriwords
