{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toriwords.app/fixtures/schema/capture-extract.schema.json",
  "title": "Sentence extraction and highlight",
  "type": "object",
  "properties": {
    "kind": {
      "const": "capture-extract"
    },
    "source": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "input": {
            "type": "string"
          },
          "chosenChips": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 2,
            "maxItems": 2
          },
          "expected": {
            "type": "object",
            "properties": {
              "entryText": {
                "type": "string"
              },
              "sentence": {
                "type": "string",
                "maxLength": 500
              },
              "highlight": {
                "type": "object",
                "properties": {
                  "offset": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "length": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "offset",
                  "length"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "entryText",
              "sentence",
              "highlight"
            ],
            "additionalProperties": false
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "input",
          "chosenChips",
          "expected"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "kind",
    "source",
    "cases"
  ],
  "additionalProperties": false
}
