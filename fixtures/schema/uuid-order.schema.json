{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toriwords.app/fixtures/schema/uuid-order.schema.json",
  "title": "Unsigned byte order of IDs",
  "type": "object",
  "properties": {
    "kind": {
      "const": "uuid-order"
    },
    "source": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "a": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "b": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "expected": {
                "enum": [
                  -1,
                  0,
                  1
                ]
              },
              "note": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "a",
              "b",
              "expected"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "input": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                }
              },
              "expected": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                }
              },
              "note": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "input",
              "expected"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "kind",
    "source",
    "cases"
  ],
  "additionalProperties": false
}
