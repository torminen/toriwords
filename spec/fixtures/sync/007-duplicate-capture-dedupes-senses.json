{
  "kind": "sync-scenario",
  "source": "Duplicate merge by natural key: Senses of merged Entries dedupe by translation match key",
  "cases": [
    {
      "id": "007-duplicate-capture-dedupes-senses",
      "title": "Duplicate words with the same translation keep one Sense",
      "start": 1762776000000,
      "devices": {
        "A": {},
        "B": {}
      },
      "steps": [
        {
          "t": 0,
          "device": "A",
          "op": "capture",
          "term": "run",
          "translations": [
            "бежать"
          ],
          "as": "a"
        },
        {
          "t": 5,
          "device": "B",
          "op": "capture",
          "term": "Run",
          "translations": [
            "Бежать"
          ],
          "as": "b"
        },
        {
          "t": 10,
          "device": "A",
          "op": "signIn",
          "account": "alice"
        },
        {
          "t": 20,
          "device": "B",
          "op": "signIn",
          "account": "alice"
        },
        {
          "t": 30,
          "device": "A",
          "op": "sync"
        }
      ],
      "expected": {
        "devices": {
          "A": {
            "words": [
              {
                "text": "Run",
                "translations": [
                  "Бежать"
                ]
              }
            ]
          },
          "B": {
            "words": [
              {
                "text": "Run",
                "translations": [
                  "Бежать"
                ]
              }
            ]
          }
        },
        "converged": [
          "A",
          "B"
        ]
      },
      "note": "Sense natural key = canonical Entry + matchKey(translation): one Sense survives (A's, smaller ID) and takes B's later rank-1 translation value, as the Entry takes B's later text."
    }
  ]
}
