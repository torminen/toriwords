{
  "kind": "sync-scenario",
  "source": "iCloud account switch: the device's words merge silently into the new account (token and system fields cleared, every record pending); an account without the zone gets it created, not cloudDeleted",
  "cases": [
    {
      "id": "035-icloud-switch-merges-silently",
      "title": "Switching iCloud accounts keeps the words and uploads them to the new account",
      "start": 1762776000000,
      "devices": {
        "A": {},
        "B": {}
      },
      "steps": [
        {
          "t": 0,
          "device": "A",
          "op": "capture",
          "term": "run",
          "translations": [
            "бежать"
          ],
          "as": "run"
        },
        {
          "t": 10,
          "device": "A",
          "op": "enableSync",
          "account": "alice"
        },
        {
          "t": 20,
          "device": "B",
          "op": "capture",
          "term": "walk",
          "translations": [
            "идти"
          ],
          "as": "walk"
        },
        {
          "t": 30,
          "device": "B",
          "op": "enableSync",
          "account": "bob"
        },
        {
          "t": 40,
          "device": "A",
          "op": "cloudSwitch",
          "to": "bob"
        },
        {
          "t": 50,
          "device": "A",
          "op": "sync"
        },
        {
          "t": 60,
          "device": "B",
          "op": "sync"
        },
        {
          "t": 70,
          "device": "A",
          "op": "cloudSwitch",
          "to": "carol"
        },
        {
          "t": 80,
          "device": "A",
          "op": "sync"
        }
      ],
      "note": "No prompt and no merge summary: the switch is silent. carol has no zone yet, so A creates it and claims a new generation.",
      "expected": {
        "devices": {
          "A": {
            "words": [
              {
                "text": "run",
                "translations": [
                  "бежать"
                ]
              },
              {
                "text": "walk",
                "translations": [
                  "идти"
                ]
              }
            ],
            "sync": {
              "state": "synced",
              "outbox": 0,
              "user": "carol"
            }
          },
          "B": {
            "words": [
              {
                "text": "run",
                "translations": [
                  "бежать"
                ]
              },
              {
                "text": "walk",
                "translations": [
                  "идти"
                ]
              }
            ],
            "sync": {
              "state": "synced",
              "outbox": 0,
              "user": "bob"
            }
          }
        },
        "cloud": {
          "alice": {
            "entries": {
              "live": 1,
              "deleted": 0,
              "merged": 0
            }
          },
          "bob": {
            "entries": {
              "live": 2,
              "deleted": 0,
              "merged": 0
            }
          },
          "carol": {
            "entries": {
              "live": 2,
              "deleted": 0,
              "merged": 0
            }
          }
        },
        "converged": [
          "A",
          "B"
        ]
      }
    }
  ]
}
