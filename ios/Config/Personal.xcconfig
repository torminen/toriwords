// "Personal" configuration (scheme Toriwords-Personal): a device build with a free Apple ID (Personal Team).
// No iCloud and no App Group (a Personal Team cannot sign them): no sync; Share capture and the widget are hidden.
// Words, review, speech, translation and the dictionary work.
#include "Shared.xcconfig"

// Set both in Personal.local.xcconfig (gitignored; copy Personal.local.xcconfig.example): your Personal Team ID and a
// bundle ID prefix nobody else has.
DEVELOPMENT_TEAM = TEAMID0000
TORI_BUNDLE_ID = com.example.toriwords

TORI_CLOUD_SYNC = NO

#include? "Personal.local.xcconfig"
