{
  "kind": "sync-scenario",
  "source": "doc 36 §11.3",
  "cases": [
    {
      "id": "004-user-edit-beats-later-automatic",
      "title": "A user value beats a later automatic value of the same field (rank first)",
      "start": 1762776000000,
      "devices": {
        "A": {},
        "B": {}
      },
      "steps": [
        {
          "t": 0,
          "device": "A",
          "op": "capture",
          "term": "run",
          "translations": [
            "бежать"
          ],
          "as": "run"
        },
        {
          "t": 10,
          "device": "A",
          "op": "signIn",
          "account": "alice"
        },
        {
          "t": 20,
          "device": "B",
          "op": "signIn",
          "account": "alice"
        },
        {
          "t": 100,
          "device": "A",
          "op": "editField",
          "entry": "run",
          "field": "ipa",
          "value": "/rʌn/"
        },
        {
          "t": 200,
          "device": "B",
          "op": "enrich",
          "entry": "run",
          "ipa": "/ran/"
        },
        {
          "t": 300,
          "device": "A",
          "op": "sync"
        },
        {
          "t": 301,
          "device": "B",
          "op": "sync"
        },
        {
          "t": 302,
          "device": "A",
          "op": "sync"
        },
        {
          "t": 303,
          "device": "B",
          "op": "sync"
        }
      ],
      "expected": {
        "devices": {
          "A": {
            "words": [
              {
                "text": "run",
                "ipa": "/rʌn/"
              }
            ]
          },
          "B": {
            "words": [
              {
                "text": "run",
                "ipa": "/rʌn/"
              }
            ]
          }
        },
        "converged": [
          "A",
          "B"
        ]
      }
    }
  ]
}
