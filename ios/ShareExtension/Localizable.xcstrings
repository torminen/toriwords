  "strings": {
    "Already in your vocabulary": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже в вашем словаре"
          }
        }
      }
    },
    "Cancel": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить"
          }
        }
      }
    },
    "Could not save. Open ToriWords once, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить. Откройте ToriWords и попробуйте снова."
          }
        }
      }
    },
    "In the share menu, scroll the app row to More → Edit and drag ToriWords to the top.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В меню «Поделиться» прокрутите ряд приложений до «Ещё» → «Изменить» и перетащите ToriWords наверх."
          }
        }
      }
    },
    "Not in the dictionary": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет в словаре"
