            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "local": {
            "type": "object",
            "properties": {
              "v": {},
              "c": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$"
              },
              "u": {
                "enum": [
                  0,
                  1
                ]
              }
            },
            "required": [
              "v",
              "c",
              "u"
            ],
            "additionalProperties": false
          },
          "remote": {
            "type": "object",
            "properties": {
              "v": {},
              "c": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$"
              },
              "u": {
                "enum": [
                  0,
                  1
                ]
              }
            },
            "required": [
              "v",
              "c",
              "u"
            ],
            "additionalProperties": false
          },
          "expected": {
            "enum": [
              "local",
              "remote"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "local",
          "remote",
          "expected"
        ],
        "additionalProperties": false
      }
    }
