        "B": {}
      },
      "steps": [
        {
          "t": 0,
          "device": "A",
          "op": "capture",
          "term": "run",
          "translations": [
            "бежать"
          ],
          "as": "a"
        },
        {
          "t": 5,
          "device": "B",
          "op": "capture",
          "term": "run",
          "translations": [
            "бег"
          ],
          "as": "b"
        },
        {
          "t": 8,
          "device": "B",
          "op": "signIn",
          "account": "alice"
        },
        {
          "t": 20,
          "device": "A",
          "op": "signIn",
          "account": "alice"
        },
        {
          "t": 30,
          "device": "B",
