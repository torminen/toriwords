{
  "kind": "sync-scenario",
  "source": "doc 36 §12.5",
  "cases": [
    {
      "id": "032-foreign-account-add",
      "title": "Another account's words: 'Add' uploads them and merges with the account",
      "start": 1762776000000,
      "devices": {
        "A": {},
        "B": {}
      },
      "steps": [
        {
          "t": 0,
          "device": "B",
          "op": "capture",
          "term": "swim",
          "translations": [
            "плавать"
          ],
          "as": "swim"
        },
        {
          "t": 5,
          "device": "B",
          "op": "signIn",
          "account": "bob"
        },
        {
          "t": 0,
          "device": "A",
          "op": "capture",
          "term": "run",
          "translations": [
            "бежать"
          ],
          "as": "run"
        },
        {
          "t": 10,
          "device": "A",
          "op": "signIn",
          "account": "alice"
        },
        {
          "t": 20,
          "device": "A",
          "op": "signOut"
        },
        {
          "t": 30,
          "device": "A",
          "op": "signIn",
          "account": "bob"
        },
        {
          "t": 40,
          "device": "A",
          "op": "accountChoice",
          "choice": "add"
        },
        {
          "t": 50,
          "device": "B",
          "op": "sync"
        }
      ],
      "expected": {
        "devices": {
          "A": {
            "words": [
              {
                "text": "run"
              },
              {
                "text": "swim"
              }
            ],
            "account": {
              "state": "synced",
              "signedIn": "bob",
              "lastSynced": "bob",
              "pendingChoice": false,
              "outbox": 0
            },
            "notices": [
              "backedUp",
              "accountPrompt:1"
            ]
          },
          "B": {
            "words": [
              {
                "text": "run"
              },
              {
                "text": "swim"
              }
            ]
          }
        },
        "hub": {
          "bob": {
            "entries": {
              "live": 2,
              "deleted": 0,
              "merged": 0
            }
          }
        }
      }
    }
  ]
}
