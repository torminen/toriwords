          "device": "A",
          "op": "sync"
        },
        {
          "t": 60,
          "device": "B",
          "op": "sync"
        },
        {
          "t": 70,
          "device": "A",
          "op": "sync"
        },
        {
          "t": 80,
          "device": "B",
          "op": "sync"
        },
        {
          "t": 90,
          "device": "A",
          "op": "sync"
        }
