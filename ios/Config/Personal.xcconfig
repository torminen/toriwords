// "Personal" configuration (scheme Toriwords-Personal): a device build with a free Apple ID (Personal Team).
// No iCloud and no App Group (a Personal Team cannot sign them): no sync, the Share Extension cannot hand words
// to the app, the widget stays empty. Words, review, speech, translation and the dictionary work.
#include "Shared.xcconfig"

// Set both in Personal.local.xcconfig (gitignored): your Personal Team ID and a bundle ID prefix nobody else has.
DEVELOPMENT_TEAM = TEAMID0000
TORI_BUNDLE_ID = com.example.toriwords

TORI_CLOUD_SYNC = NO

#include? "Personal.local.xcconfig"
