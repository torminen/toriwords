{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toriwords.app/fixtures/schema/fsrs-replay.schema.json",
  "title": "Card state replay (doc 36 §7.6)",
  "type": "object",
  "properties": {
    "kind": {
      "const": "fsrs-replay"
    },
    "source": {
      "type": "string"
    },
    "params": {
      "type": "object",
      "properties": {
        "w": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 21,
          "maxItems": 21
        },
        "desiredRetention": {
          "type": "number"
        },
        "maximumInterval": {
          "type": "integer"
        }
      },
      "required": [
        "w",
        "desiredRetention",
        "maximumInterval"
      ],
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "cardId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "logs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "reviewedAt": {
                  "type": "integer"
                },
                "utcOffsetMin": {
                  "type": "integer"
                },
                "rating": {
                  "anyOf": [
                    {
                      "enum": [
                        1,
                        2,
                        3,
                        4
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "id",
                "reviewedAt",
                "utcOffsetMin",
                "rating"
              ],
              "additionalProperties": false
            }
          },
          "expected": {
            "type": "object",
            "properties": {
              "steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "stability": {
                      "type": "number"
                    },
                    "difficulty": {
                      "type": "number"
                    },
                    "lastReviewDay": {
                      "type": "integer"
                    },
                    "dueDay": {
                      "type": "integer"
                    },
                    "interval": {
                      "anyOf": [
                        {
                          "type": "integer"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "reps": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "lapses": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "stage": {
                      "enum": [
                        "learning",
                        "known_well"
                      ]
                    },
                    "logId": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                    },
                    "reviewDay": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "stability",
                    "difficulty",
                    "lastReviewDay",
                    "dueDay",
                    "interval",
                    "reps",
                    "lapses",
                    "stage",
                    "logId",
                    "reviewDay"
                  ],
                  "additionalProperties": false
                }
              },
              "final": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "stability": {
                        "type": "number"
                      },
                      "difficulty": {
                        "type": "number"
                      },
                      "lastReviewDay": {
                        "type": "integer"
                      },
                      "dueDay": {
                        "type": "integer"
                      },
                      "interval": {
                        "anyOf": [
                          {
                            "type": "integer"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "reps": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "lapses": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "stage": {
                        "enum": [
                          "learning",
                          "known_well"
                        ]
                      }
                    },
                    "required": [
                      "stability",
                      "difficulty",
                      "lastReviewDay",
                      "dueDay",
                      "interval",
                      "reps",
                      "lapses",
                      "stage"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "steps",
              "final"
            ],
            "additionalProperties": false
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "cardId",
          "logs",
          "expected"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "kind",
    "source",
    "params",
    "cases"
  ],
  "additionalProperties": false
}
