{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toriwords.app/fixtures/schema/uuid-v5.schema.json",
  "title": "Deterministic UUIDv5 names (doc 36 §11.2)",
  "type": "object",
  "properties": {
    "kind": {
      "const": "uuid-v5"
    },
    "source": {
      "type": "string"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "record": {
            "enum": [
              "languagePair",
              "settings",
              "card",
              "source",
              "entryTag",
              "autoSense",
              "importedReviewLog"
            ]
          },
          "params": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "integer"
              ]
            }
          },
          "name": {
            "type": "string"
          },
          "uuid": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "record",
          "params",
          "name",
          "uuid"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "kind",
    "source",
    "namespace",
    "cases"
  ],
  "additionalProperties": false
}
