{
  "kind": "text-key",
  "function": "matchKey",
  "source": "doc 36 §15.1 Match key (steps 1–7); character lists in spec/fixtures/README.md",
  "cases": [
    { "id": "mk-001", "input": "Run", "expected": "run" },
    { "id": "mk-002", "input": "  take   off  ", "expected": "take off" },
    { "id": "mk-003", "input": "Don’t", "expected": "don't", "note": "right single quote → apostrophe" },
    { "id": "mk-004", "input": "itʼs", "expected": "it's", "note": "modifier letter apostrophe" },
    { "id": "mk-005", "input": "“quote”", "expected": "quote", "note": "mapped to \" then stripped as edge punctuation" },
    { "id": "mk-006", "input": "well‐being", "expected": "well-being", "note": "U+2010 hyphen" },
    { "id": "mk-007", "input": "state–of–the–art", "expected": "state-of-the-art", "note": "en dash" },
    { "id": "mk-008", "input": "x−y", "expected": "x-y", "note": "minus sign" },
    { "id": "mk-009", "input": "a priori", "expected": "a priori", "note": "NBSP" },
    { "id": "mk-010", "input": "Mr. Smith", "expected": "mr. smith", "note": "thin space; inner punctuation kept" },
    { "id": "mk-011", "input": "word　word", "expected": "word word", "note": "ideographic space" },
    { "id": "mk-012", "input": "co­operate", "expected": "cooperate", "note": "soft hyphen removed" },
    { "id": "mk-013", "input": "zero​width", "expected": "zerowidth", "note": "ZWSP removed" },
    { "id": "mk-014", "input": "﻿hello⁠", "expected": "hello", "note": "BOM and word joiner removed" },
    { "id": "mk-015", "input": "éclair", "expected": "éclair", "note": "NFC" },
    { "id": "mk-016", "input": "Å", "expected": "å", "note": "angstrom sign → NFC Å → å" },
    { "id": "mk-017", "input": "ﬁne", "expected": "ﬁne", "note": "NFC only, no compatibility decomposition" },
    { "id": "mk-018", "input": "Ёлка", "expected": "елка", "note": "Ёлка → елка" },
    { "id": "mk-019", "input": "ЕЩЁ", "expected": "еще", "note": "ЕЩЁ → еще" },
    { "id": "mk-020", "input": "İstanbul", "expected": "i̇stanbul", "note": "U+0130 → i + U+0307 (full default mapping, no Turkish locale)" },
    { "id": "mk-021", "input": "ΟΔΟΣ", "expected": "οδοσ", "note": "Σ → σ always; no final-sigma context" },
    { "id": "mk-022", "input": "Straße", "expected": "straße", "note": "lowercase keeps ß" },
    { "id": "mk-023", "input": "ǅ", "expected": "ǆ", "note": "titlecase Dž → dž" },
    { "id": "mk-024", "input": "...hello!!!", "expected": "hello" },
    { "id": "mk-025", "input": "(well) .", "expected": "well", "note": "edge punctuation and whitespace stripped repeatedly" },
    { "id": "mk-026", "input": "«ёжик»", "expected": "ежик", "note": "«ёжик» → ежик" },
    { "id": "mk-027", "input": "C#", "expected": "c", "note": "# is punctuation (Po) → stripped" },
    { "id": "mk-028", "input": "C++", "expected": "c++", "note": "+ is a symbol (Sm) → kept" },
    { "id": "mk-029", "input": "$100", "expected": "$100", "note": "currency symbol kept" },
    { "id": "mk-030", "input": "rock 'n' roll", "expected": "rock 'n' roll", "note": "inner punctuation kept" },
    { "id": "mk-031", "input": "'tis", "expected": "tis", "note": "leading apostrophe is edge punctuation" },
    { "id": "mk-032", "input": "–dash", "expected": "dash", "note": "en dash → - → stripped at the edge" },
    { "id": "mk-033", "input": "1′", "expected": "1", "note": "prime → ' → stripped at the edge" },
    { "id": "mk-034", "input": "\tline\nbreak\r\n", "expected": "line break" },
    { "id": "mk-035", "input": "!!!", "expected": "", "note": "empty key: the caller rejects it" },
    { "id": "mk-036", "input": "", "expected": "" },
    { "id": "mk-037", "input": "Take Off…", "expected": "take off", "note": "horizontal ellipsis is punctuation" },
    { "id": "mk-038", "input": "😀 smile", "expected": "😀 smile", "note": "emoji (So) kept at the edge" }
  ]
}
