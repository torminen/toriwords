{
  "kind": "sync-scenario",
  "source": "doc 36 §11.3, §11.9",
  "cases": [
    {
      "id": "026-clock-skew-persists",
      "title": "A push with clocks > 1 h ahead is rejected; the rows stay pending",
      "start": 1762776000000,
      "devices": {
        "A": {},
        "B": {}
      },
      "steps": [
        {
          "t": 0,
          "device": "A",
          "op": "capture",
          "term": "run",
          "translations": [
            "бежать"
          ],
          "as": "run"
        },
        {
          "t": 10,
          "device": "A",
          "op": "signIn",
          "account": "alice"
        },
        {
          "t": 20,
          "device": "B",
          "op": "signIn",
          "account": "alice"
        },
        {
          "t": 100,
          "device": "A",
          "op": "setClock",
          "offsetSec": 7200
        },
        {
          "t": 110,
          "device": "A",
          "op": "editField",
          "entry": "run",
          "field": "note",
          "value": "ahead"
        },
        {
          "t": 120,
          "device": "A",
          "op": "sync"
        },
        {
          "t": 130,
          "device": "B",
          "op": "pullOnly"
        }
      ],
      "expected": {
        "devices": {
          "A": {
            "words": [
              {
                "text": "run",
                "note": "ahead"
              }
            ],
            "account": {
              "state": "clockSkew",
              "signedIn": "alice",
              "lastSynced": "alice",
              "pendingChoice": false,
              "outbox": 1
            }
          },
          "B": {
            "words": [
              {
                "text": "run",
                "note": null
              }
            ]
          }
        }
      },
      "note": "Recovery re-stamps with max(serverTime, device now), still ahead, so the retry fails too."
    }
  ]
}
