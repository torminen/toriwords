{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toriwords.app/fixtures/schema/capture-clean.schema.json",
  "title": "Capture clean / classify / reject",
  "type": "object",
  "properties": {
    "kind": {
      "const": "capture-clean"
    },
    "source": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "input": {
            "type": "string"
          },
          "expected": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "term",
                  "sentence"
                ]
              },
              "saveable": {
                "type": "boolean"
              }
            },
            "required": [
              "text",
              "kind",
              "saveable"
            ],
            "additionalProperties": false
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "input",
          "expected"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "kind",
    "source",
    "cases"
  ],
  "additionalProperties": false
}
