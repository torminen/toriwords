{
  "kind": "sync-scenario",
  "source": "doc 36 §12.4, §12.5",
  "cases": [
    {
      "id": "030-foreign-account-paused-on-cancel",
      "title": "Another account's words: Cancel pauses sync, nothing is uploaded",
      "start": 1762776000000,
      "devices": {
        "A": {}
      },
      "steps": [
        {
          "t": 0,
          "device": "A",
          "op": "capture",
          "term": "run",
          "translations": [
            "бежать"
          ],
          "as": "run"
        },
        {
          "t": 10,
          "device": "A",
          "op": "signIn",
          "account": "alice"
        },
        {
          "t": 20,
          "device": "A",
          "op": "signOut"
        },
        {
          "t": 30,
          "device": "A",
          "op": "signIn",
          "account": "bob"
        },
        {
          "t": 31,
          "device": "A",
          "op": "accountChoice",
          "choice": "cancel"
        },
        {
          "t": 40,
          "device": "A",
          "op": "capture",
          "term": "walk",
          "translations": [
            "идти"
          ],
          "as": "walk"
        },
        {
          "t": 50,
          "device": "A",
          "op": "sync"
        }
      ],
      "expected": {
        "devices": {
          "A": {
            "words": [
              {
                "text": "run"
              },
              {
                "text": "walk"
              }
            ],
            "account": {
              "state": "paused",
              "signedIn": "bob",
              "lastSynced": "alice",
              "pendingChoice": true,
              "outbox": 0
            },
            "notices": [
              "backedUp",
              "accountPrompt:1"
            ]
          }
        },
        "hub": {
          "bob": {
            "entries": {
              "live": 0,
              "deleted": 0,
              "merged": 0
            }
          }
        }
      }
    }
  ]
}
