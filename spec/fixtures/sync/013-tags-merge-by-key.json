{
  "kind": "sync-scenario",
  "source": "Duplicate merge: Tags merge by tag key",
  "cases": [
    {
      "id": "013-tags-merge-by-key",
      "title": "The same tag created on two devices becomes one tag",
      "start": 1762776000000,
      "devices": {
        "A": {},
        "B": {}
      },
      "steps": [
        {
          "t": 0,
          "device": "A",
          "op": "capture",
          "term": "run",
          "translations": [
            "бежать"
          ],
          "as": "run"
        },
        {
          "t": 10,
          "device": "A",
          "op": "signIn",
          "account": "alice"
        },
        {
          "t": 20,
          "device": "B",
          "op": "signIn",
          "account": "alice"
        },
        {
          "t": 100,
          "device": "A",
          "op": "tag",
          "entry": "run",
          "name": "Verbs"
        },
        {
          "t": 200,
          "device": "B",
          "op": "tag",
          "entry": "run",
          "name": "verbs"
        },
        {
          "t": 300,
          "device": "A",
          "op": "sync"
        },
        {
          "t": 301,
          "device": "B",
          "op": "sync"
        },
        {
          "t": 302,
          "device": "A",
          "op": "sync"
        },
        {
          "t": 303,
          "device": "B",
          "op": "sync"
        }
      ],
      "expected": {
        "devices": {
          "A": {
            "words": [
              {
                "text": "run",
                "tags": [
                  "verbs"
                ]
              }
            ]
          },
          "B": {
            "words": [
              {
                "text": "run",
                "tags": [
                  "verbs"
                ]
              }
            ]
          }
        },
        "converged": [
          "A",
          "B"
        ]
      }
    }
  ]
}
