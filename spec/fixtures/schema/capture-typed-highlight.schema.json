{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toriwords.app/fixtures/schema/capture-typed-highlight.schema.json",
  "title": "Highlight for typed sentences (doc 36 §5.2 step 6)",
  "type": "object",
  "properties": {
    "kind": {
      "const": "capture-typed-highlight"
    },
    "source": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "sentence": {
            "type": "string"
          },
          "entryText": {
            "type": "string"
          },
          "expected": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "offset": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "length": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "offset",
                  "length"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "sentence",
          "entryText",
          "expected"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "kind",
    "source",
    "cases"
  ],
  "additionalProperties": false
}
