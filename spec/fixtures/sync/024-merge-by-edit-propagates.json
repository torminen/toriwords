            ]
          },
          "B": {
            "words": [
              {
                "text": "run",
                "translations": [
                  "бежать",
                  "мчаться"
                ]
              }
            ]
          }
        },
        "hub": {
          "alice": {
            "entries": {
              "live": 1,
              "deleted": 0,
              "merged": 1
            }
          }
        },
        "converged": [
          "A",
          "B"
        ]
