{
  "kind": "sync-scenario",
  "source": "Delete wins: a deleted record never comes back, even after an offline edit",
  "cases": [
    {
      "id": "009-delete-wins-over-offline-edit",
      "title": "A delete on one device beats an offline edit on another",
      "start": 1762776000000,
      "devices": {
        "A": {},
        "B": {}
      },
      "steps": [
        {
          "t": 0,
          "device": "A",
          "op": "capture",
          "term": "run",
          "translations": [
            "бежать"
          ],
          "as": "run"
        },
        {
          "t": 10,
          "device": "A",
          "op": "enableSync",
          "account": "alice"
        },
        {
          "t": 20,
          "device": "B",
          "op": "enableSync",
          "account": "alice"
        },
        {
          "t": 100,
          "device": "A",
          "op": "delete",
          "entry": "run"
        },
        {
          "t": 200,
          "device": "B",
          "op": "editField",
          "entry": "run",
          "field": "note",
          "value": "edited offline"
        },
        {
          "t": 300,
          "device": "A",
          "op": "sync"
        },
        {
          "t": 301,
          "device": "B",
          "op": "sync"
        },
        {
          "t": 302,
          "device": "A",
          "op": "sync"
        },
        {
          "t": 303,
          "device": "B",
          "op": "sync"
        }
      ],
      "expected": {
        "devices": {
          "A": {
            "words": []
          },
          "B": {
            "words": []
          }
        },
        "cloud": {
          "alice": {
            "entries": {
              "live": 0,
              "deleted": 1,
              "merged": 0
            }
          }
        },
        "converged": [
          "A",
          "B"
        ]
      }
    }
  ]
}
