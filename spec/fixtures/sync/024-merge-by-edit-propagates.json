  "cases": [
    {
      "id": "024-merge-by-edit-propagates",
      "title": "A confirmed merge by edit reaches the other device",
      "start": 1762776000000,
      "devices": {
        "A": {},
        "B": {}
      },
      "steps": [
        {
          "t": 0,
          "device": "A",
          "op": "capture",
          "term": "run",
          "translations": [
            "бежать"
          ],
          "as": "a"
        },
        {
          "t": 5,
          "device": "A",
          "op": "capture",
          "term": "runn",
          "translations": [
            "мчаться"
          ],
          "as": "b"
        },
        {
          "t": 10,
          "device": "A",
          "op": "signIn",
          "account": "alice"
