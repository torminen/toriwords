        {
          "t": 210,
          "device": "A",
          "op": "sync"
        },
        {
          "t": 220,
          "device": "B",
          "op": "sync"
        },
        {
          "t": 300,
          "device": "B",
          "op": "editField",
          "entry": "run",
          "field": "note",
          "value": "later on B"
        },
        {
          "t": 400,
          "device": "B",
          "op": "sync"
        },
        {
          "t": 401,
          "device": "A",
          "op": "sync"
        },
        {
          "t": 402,
          "device": "B",
          "op": "sync"
        },
        {
          "t": 403,
          "device": "A",
          "op": "sync"
        }
      ],
      "expected": {
        "devices": {
          "A": {
            "words": [
              {
                "text": "run",
                "note": "later on B"
              }
            ],
            "account": {
              "state": "synced",
              "signedIn": "alice",
              "lastSynced": "alice",
              "pendingChoice": false,
              "outbox": 0
            }
          },
          "B": {
            "words": [
              {
                "text": "run",
                "note": "later on B"
              }
            ],
            "account": {
              "state": "synced",
              "signedIn": "alice",
              "lastSynced": "alice",
              "pendingChoice": false,
              "outbox": 0
            }
          }
        },
        "converged": [
          "A",
          "B"
        ]
      },
      "note": "The re-stamped clock is the real time of the sync, so B's later edit wins."
    }
