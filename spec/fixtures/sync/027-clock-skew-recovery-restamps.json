      "id": "027-clock-skew-recovery-restamps",
      "title": "After the device clock is fixed, the clock-ahead check re-stamps and pushes",
      "start": 1762776000000,
      "devices": {
        "A": {},
        "B": {}
      },
      "steps": [
        {
          "t": 0,
          "device": "A",
          "op": "capture",
          "term": "run",
          "translations": [
            "бежать"
          ],
          "as": "run"
        },
        {
          "t": 10,
          "device": "A",
          "op": "signIn",
          "account": "alice"
        },
        {
          "t": 20,
          "device": "B",
          "op": "signIn",
          "account": "alice"
        },
        {
          "t": 100,
          "device": "A",
          "op": "setClock",
          "offsetSec": 7200
        },
        {
          "t": 110,
          "device": "A",
          "op": "editField",
          "entry": "run",
          "field": "note",
          "value": "ahead"
        },
        {
          "t": 120,
          "device": "A",
          "op": "sync"
