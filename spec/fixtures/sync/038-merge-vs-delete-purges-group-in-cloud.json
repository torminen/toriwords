          "translations": [
            "бежать"
          ],
          "as": "y"
        },
        {
          "t": 5,
          "device": "A",
          "op": "capture",
          "term": "sprint",
          "translations": [
            "мчаться"
          ],
          "as": "x"
        },
        {
          "t": 10,
          "device": "A",
          "op": "enableSync",
          "account": "alice"
        },
        {
          "t": 20,
          "device": "B",
