{
  "kind": "sync-scenario",
  "source": "Clock-ahead recovery at cycle start: the HLC is more than 1 h ahead of the last cloud modification date (lastServerTime), so it is reset and every pending outbox field is re-stamped",
  "cases": [
    {
      "id": "027-clock-skew-recovery-restamps",
      "title": "After the device clock is fixed, the clock-ahead check re-stamps and pushes",
      "start": 1762776000000,
      "devices": {
        "A": {},
        "B": {}
      },
      "steps": [
        {
          "t": 0,
          "device": "A",
          "op": "capture",
          "term": "run",
          "translations": [
            "бежать"
          ],
          "as": "run"
        },
        {
          "t": 10,
          "device": "A",
          "op": "enableSync",
          "account": "alice"
        },
        {
          "t": 20,
          "device": "B",
          "op": "enableSync",
          "account": "alice"
        },
        {
          "t": 100,
          "device": "A",
          "op": "setClock",
          "offsetSec": 7200
        },
        {
          "t": 110,
          "device": "A",
          "op": "editField",
          "entry": "run",
          "field": "note",
          "value": "ahead"
        },
        {
          "t": 200,
          "device": "A",
          "op": "setClock",
          "offsetSec": 0
        },
        {
          "t": 210,
          "device": "A",
          "op": "sync"
        },
        {
          "t": 220,
          "device": "B",
          "op": "sync"
        },
        {
          "t": 300,
          "device": "B",
          "op": "editField",
          "entry": "run",
          "field": "note",
          "value": "later on B"
        },
        {
          "t": 400,
          "device": "B",
          "op": "sync"
        },
        {
          "t": 401,
          "device": "A",
          "op": "sync"
        },
        {
          "t": 402,
          "device": "B",
          "op": "sync"
        },
        {
          "t": 403,
          "device": "A",
          "op": "sync"
        }
      ],
      "expected": {
        "devices": {
          "A": {
            "words": [
              {
                "text": "run",
                "note": "later on B"
              }
            ],
            "sync": {
              "state": "synced",
              "outbox": 0
            }
          },
          "B": {
            "words": [
              {
                "text": "run",
                "note": "later on B"
              }
            ],
            "sync": {
              "state": "synced",
              "outbox": 0
            }
          }
        },
        "converged": [
          "A",
          "B"
        ]
      },
      "note": "A's clock runs 2 h ahead while it edits; the edit stays pending. lastServerTime is the cloud modification date of A's first save (t = 10, cloud now). After the clock is fixed the cycle re-stamps the pending field with the real time, so B's later edit wins."
    }
  ]
}
