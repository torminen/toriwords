{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toriwords.app/fixtures/schema/source-key.schema.json",
  "title": "Source natural key without URL (doc 36 §11.7, §15.1)",
  "type": "object",
  "properties": {
    "kind": {
      "const": "source-key"
    },
    "source": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "input": {
            "type": "object",
            "properties": {
              "title": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "app": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "kind": {
                "enum": [
                  "web",
                  "app",
                  "other",
                  "suggested"
                ]
              }
            },
            "required": [
              "title",
              "app",
              "kind"
            ],
            "additionalProperties": false
          },
          "expected": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "app": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "suggested": {
                "type": "boolean"
              }
            },
            "required": [
              "title",
              "app",
              "suggested"
            ],
            "additionalProperties": false
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "input",
          "expected"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "kind",
    "source",
    "cases"
  ],
  "additionalProperties": false
}
