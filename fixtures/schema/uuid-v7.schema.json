{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toriwords.app/fixtures/schema/uuid-v7.schema.json",
  "title": "UUIDv7 layout (RFC 9562)",
  "type": "object",
  "properties": {
    "kind": {
      "const": "uuid-v7"
    },
    "source": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "unixMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 281474976710655
          },
          "randA": {
            "type": "string",
            "pattern": "^[0-9a-f]{3}$"
          },
          "randB": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          },
          "uuid": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "unixMs",
          "randA",
          "randB",
          "uuid"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "kind",
    "source",
    "cases"
  ],
  "additionalProperties": false
}
